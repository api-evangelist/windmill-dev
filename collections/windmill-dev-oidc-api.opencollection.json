{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill Apps OIDC API",
    "version": "1.745.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OIDC",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate an OIDC token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.windmill.dev/api/w/:workspace/oidc/token",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "The workspace id (tenant) the resource belongs to."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Mints a short-lived OIDC (JWT) token, scoped to the current job/identity, for authenticating to external cloud providers without long-lived secrets. Enterprise Edition feature."
        }
      ]
    }
  ],
  "bundled": true
}