{
  "opencollection": "1.0.0",
  "info": {
    "name": "Windmill Apps API",
    "version": "1.745.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.windmill.dev/api/w/:workspace/apps/list",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "The workspace id (tenant) the resource belongs to."
              }
            ]
          },
          "docs": "Lists low-code apps in a workspace."
        },
        {
          "info": {
            "name": "Get an app by path",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.windmill.dev/api/w/:workspace/apps/get/p/:path",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "The workspace id (tenant) the resource belongs to."
              },
              {
                "name": "path",
                "value": "",
                "type": "path",
                "description": "The runnable/resource path (e.g. u/username/my_script or f/folder/name)."
              }
            ]
          },
          "docs": "Retrieves an app by its path."
        }
      ]
    }
  ],
  "bundled": true
}